{
	"name": "@soverity/sdk",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"require": "./dist/server.cjs"
		},
		"./button": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./styles.css": "./dist/button.css"
	},
	"files": ["dist"],
	"sideEffects": ["**/*.css"],
	"scripts": {
		"build": "tsup && node -e \"require('fs').copyFileSync('src/button/SoverityButton.css','dist/button.css')\"",
		"dev": "tsup --watch",
		"lint": "biome check src test",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": { "optional": true }
	},
	"devDependencies": {
		"@soverity/config": "workspace:*",
		"@types/react": "^18.3.12",
		"react": "^18.3.1",
		"tsup": "^8.3.5",
		"typescript": "^7.0.2",
		"vitest": "^2.1.8"
	}
}
