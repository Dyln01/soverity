{
	"name": "@soverity/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./preset": {
			"types": "./dist/preset.d.ts",
			"import": "./dist/preset.js",
			"require": "./dist/preset.cjs"
		},
		"./styles.css": "./src/glass.css"
	},
	"files": ["dist", "src/glass.css"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome check src",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@soverity/config": "workspace:*",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^3.4.17",
		"tsup": "^8.3.5",
		"typescript": "^7.0.2",
		"vitest": "^2.1.8"
	}
}
